<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <variable name="logDirectory" value="D:\Logs\DXX"/>
  
  <!-- 日志格式定义 -->
  <variable name="defaultLayout" value="${date:format=yyMMdd HH\:mm\:ss.fff} ${level:uppercase=true:truncate=1} [${logger:shortName=true}]: ${message} ${exception:format=tostring}"/>

  <!-- 输出目标定义 -->
  <targets>
    
    <!-- 控制台输出 -->
    <target xsi:type="ColoredConsole" 
            name="console" 
            layout="${defaultLayout}">
      <highlight-row condition="level == LogLevel.Debug" foregroundColor="Cyan"/>
      <highlight-row condition="level == LogLevel.Info" foregroundColor="White"/>
      <highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow"/>
      <highlight-row condition="level == LogLevel.Error" foregroundColor="Red"/>
      <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Red" backgroundColor="White"/>
    </target>

    <!-- 总日志文件 - Debug/Info/Error都放一起 -->
    <!-- 文件路径使用系统时间，确保目录可以立即创建 -->
    <target xsi:type="File" 
            name="debugFile"
            fileName="${logDirectory}\${date:format=yyyy-MM}\DebugLog\DebugLog_${date:format=yy-MM-dd}.log"
            layout="${defaultLayout}"
            encoding="utf-8"
            archiveEvery="Day"
            maxArchiveFiles="30"
            keepFileOpen="false"
            createDirs="true"/>

    <!-- 数据库日志文件 -->
    <!-- 文件路径使用系统时间，确保目录可以立即创建 -->
    <target xsi:type="File" 
            name="sqlFile"
            fileName="${logDirectory}\${date:format=yyyy-MM}\SQLLog\SQLLog_${date:format=yy-MM-dd}.log"
            layout="${defaultLayout}"
            encoding="utf-8"
            archiveEvery="Day"
            maxArchiveFiles="30"
            keepFileOpen="false"
            createDirs="true"/>

    <!-- MES通信日志文件 -->
    <!-- 文件路径使用系统时间，确保目录可以立即创建 -->
    <target xsi:type="File" 
            name="mesFile"
            fileName="${logDirectory}\${date:format=yyyy-MM}\MesLog\MesLog_${date:format=yy-MM-dd}.log"
            layout="${defaultLayout}"
            encoding="utf-8"
            archiveEvery="Day"
            maxArchiveFiles="30"
            keepFileOpen="false"
            createDirs="true"/>

    <!-- 参数变更日志文件 -->
    <!-- 文件路径使用系统时间，确保目录可以立即创建 -->
    <target xsi:type="File"
            name="chargeFile"
            fileName="${logDirectory}\${date:format=yyyy-MM}\ChargeLog\ChargeLog_${date:format=yy-MM-dd}.log"
            layout="${defaultLayout}"
            encoding="utf-8"
            archiveEvery="Day"
            maxArchiveFiles="30"
            keepFileOpen="false"
            createDirs="true"/>

    <!-- 报警信息日志文件 -->
    <!-- 文件路径使用系统时间，确保目录可以立即创建 -->
    <target xsi:type="File"
            name="alarmFile"
            fileName="${logDirectory}\${date:format=yyyy-MM}\AlarmLog\AlarmLog_${date:format=yy-MM-dd}.log"
            layout="${defaultLayout}"
            encoding="utf-8"
            archiveEvery="Day"
            maxArchiveFiles="30"
            keepFileOpen="false"
            createDirs="true"/>

  </targets>

  <!-- 日志规则 -->
  <rules>
    <!-- 总日志 - Debug/Info/Error都放一起 -->
    <logger name="Debug" minlevel="Debug" writeTo="debugFile,console" final="true"/>
    
    <!-- 数据库日志 - 不输出到控制台 -->
    <logger name="SQLLog" minlevel="Debug" writeTo="sqlFile" final="true"/>
    
    <!-- MES日志 - 不输出到控制台 -->
    <logger name="MesLog" minlevel="Debug" writeTo="mesFile" final="true"/>
    
    <!-- 参数变更日志 -->
    <logger name="ChargeLog" minlevel="Info" writeTo="chargeFile,console" final="true"/>
    
    <!-- 报警信息日志 - 输出到控制台（重要） -->
    <logger name="AlarmLog" minlevel="Warn" writeTo="alarmFile,console" final="true"/>
    
    <!-- 默认日志 -->
    <logger name="*" minlevel="Debug" writeTo="debugFile,console"/>
  </rules>

</nlog>
