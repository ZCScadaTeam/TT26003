<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:dialogs="clr-namespace:AppZC.UI.Dialogs"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="340"
        x:Class="AppZC.UI.Dialogs.LicenseDialog"
        x:DataType="dialogs:LicenseDialogVM"
        Width="500"
        MinHeight="340"
        MaxHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="Transparent"
        SystemDecorations="None">

    <Design.DataContext>
        <dialogs:LicenseDialogVM />
    </Design.DataContext>

    <!-- 主容器 -->
    <Border Background="{DynamicResource CardBackgroundSolidBrush}"
            BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="8"
            Margin="10"
            BoxShadow="0 4 16 0 #40000000">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- 标题栏（可拖动） -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    Padding="20,15"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <iconPacks:PackIconCodicons Kind="Warning"
                                                   Width="20"
                                                   Height="20"
                                                   Foreground="#E0A800"
                                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="Icon"
                            Theme="{DynamicResource Button-Plain}"
                            Click="OnCloseClick"
                            ToolTip.Tip="关闭"
                            Padding="4">
                        <iconPacks:PackIconCodicons Kind="Close" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容区域 -->
            <Border Grid.Row="1" Padding="24,20">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding Description}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock Text="激活码"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,4,0,0"/>
                    <TextBox x:Name="ActivationCodeBox"
                             Text="{Binding ActivationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="请输入激活码，例如 ZC0001"
                             FontSize="14"
                             Padding="10,8"
                             MinHeight="36"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="12"
                               Foreground="#D9534F"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasError}"/>
                </StackPanel>
            </Border>

            <!-- 按钮区域 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundDarkBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="20,15">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="10">
                    <Button Content="关闭"
                            Classes="Default"
                            Theme="{DynamicResource Button-Plain}"
                            Padding="24,8"
                            FontSize="14"
                            Click="OnCloseClick"/>
                    <Button Content="激活"
                            Classes="Primary"
                            Theme="{DynamicResource Button-Solid}"
                            Padding="32,8"
                            FontSize="14"
                            IsEnabled="{Binding CanActivate}"
                            Click="OnActivateClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
