<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:pages="clr-namespace:AppZC.UI.Pages"
	mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
	x:Class="AppZC.UI.Pages.MainPage"
	x:DataType="pages:MainVM">

	<Design.DataContext>
		<pages:MainVM />
	</Design.DataContext>

	<Grid RowDefinitions="Auto,*,Auto" Margin="10">
		<!-- 顶部：三站状态卡 + PLC 状态 -->
		<Grid Grid.Row="0" ColumnDefinitions="*,*,*,260" ColumnSpacing="10">

			<!-- 打码站 -->
			<Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="8"
			        Padding="16" Background="{DynamicResource CardBackgroundBrush}">
				<Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
					<Grid Grid.Row="0" ColumnDefinitions="*,Auto">
						<TextBlock Text="{Binding MarkStation.Title}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding MarkStation.Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
						           VerticalAlignment="Center" HorizontalAlignment="Right"/>
					</Grid>
					<TextBlock Grid.Row="1" Text="PLC 触发 → MES 生成纯时间码 → 大族打标 → 回执核对 → 回写结果"
					           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
					<Grid Grid.Row="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,6,0,0">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="触发位" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
						<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MarkStation.TriggerText}" FontSize="14" FontWeight="SemiBold" Margin="0,3"/>
						<TextBlock Grid.Row="1" Grid.Column="0" Text="结果" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
						<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MarkStation.ResultText}" FontSize="17" FontWeight="Bold"
						           Foreground="{Binding MarkStation.ResultColor}" Margin="0,3"/>
						<TextBlock Grid.Row="2" Grid.Column="0" Text="时间" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
						<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MarkStation.TimeText}" FontSize="14" Margin="0,3"/>
						<TextBlock Grid.Row="3" Grid.Column="0" Text="码" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
						<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MarkStation.Detail}" FontSize="14" FontWeight="SemiBold" Margin="0,3"/>
					</Grid>
					<TextBlock Grid.Row="3" Text="1=打码完成（仅成功写 1；失败不写、保持 0 并弹窗提示）"
					           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
				</Grid>
			</Border>

			<!-- 读码站 -->
			<Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="8"
			        Padding="16" Background="{DynamicResource CardBackgroundBrush}">
				<Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="6">
					<Grid Grid.Row="0" ColumnDefinitions="*,Auto">
						<TextBlock Text="{Binding ScanStation.Title}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding ScanStation.Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
						           VerticalAlignment="Center" HorizontalAlignment="Right"/>
					</Grid>
					<TextBlock Grid.Row="1" Text="PLC 触发 → 基恩士 SR-1000 读码 → 长度/时间窗/重码比对 → 回写结果"
					           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
					<Grid Grid.Row="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,6,0,0">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="触发位" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
						<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScanStation.TriggerText}" FontSize="14" FontWeight="SemiBold" Margin="0,3"/>
						<TextBlock Grid.Row="1" Grid.Column="0" Text="结果" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
						<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ScanStation.ResultText}" FontSize="17" FontWeight="Bold"
						           Foreground="{Binding ScanStation.ResultColor}" Margin="0,3"/>
						<TextBlock Grid.Row="2" Grid.Column="0" Text="时间" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
						<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ScanStation.TimeText}" FontSize="14" Margin="0,3"/>
						<TextBlock Grid.Row="3" Grid.Column="0" Text="码" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
						<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ScanStation.Detail}" FontSize="14" FontWeight="SemiBold" Margin="0,3"/>
					</Grid>
					<StackPanel Grid.Row="3" Spacing="2" Margin="0,4,0,0">
						<CheckBox Content="循环 1s 触发扫码（只看枪返回，不校对/不写 PLC）"
						          IsChecked="{Binding LoopScanEnabled}" FontSize="11" />
						<TextBlock Text="{Binding LoopScanText}" FontSize="11" TextWrapping="Wrap"
						           Foreground="{DynamicResource TextSecondaryBrush}" />
					</StackPanel>
					<TextBlock Grid.Row="4" Text="1=OK 2=NG（扫不上自动重试 3 次；未扫到/重码/错码/枪异常 统一报 2）"
					           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
				</Grid>
			</Border>

			<!-- 采集站 -->
			<Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="8"
			        Padding="16" Background="{DynamicResource CardBackgroundBrush}">
				<Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
					<Grid Grid.Row="0" ColumnDefinitions="*,Auto">
						<TextBlock Text="{Binding UnloadStation.Title}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding UnloadStation.Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
						           VerticalAlignment="Center" HorizontalAlignment="Right"/>
					</Grid>
					<TextBlock Grid.Row="1" Text="PLC 冻结数据区 + 一次触发 → MES 分段抓全量 → 一条一记录落库"
					           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
					<Grid Grid.Row="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,6,0,0">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="触发位" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
						<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UnloadStation.TriggerText}" FontSize="14" FontWeight="SemiBold" Margin="0,3"/>
						<TextBlock Grid.Row="1" Grid.Column="0" Text="结果" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
						<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UnloadStation.ResultText}" FontSize="17" FontWeight="Bold"
						           Foreground="{Binding UnloadStation.ResultColor}" Margin="0,3"/>
						<TextBlock Grid.Row="2" Grid.Column="0" Text="时间" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
						<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UnloadStation.TimeText}" FontSize="14" Margin="0,3"/>
						<TextBlock Grid.Row="3" Grid.Column="0" Text="明细" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
						<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UnloadStation.Detail}" FontSize="14" FontWeight="SemiBold" Margin="0,3"/>
					</Grid>
					<TextBlock Grid.Row="3" Text="1=落库OK 2=落库失败（弹窗提示原因）"
					           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
				</Grid>
			</Border>

			<!-- PLC 状态卡片 -->
			<Border Grid.Column="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="8"
			        Padding="12" Background="{DynamicResource CardBackgroundBrush}">
				<LinearPanel Orientation="Vertical" Spacing="8">
					<TextBlock Text="设备状态" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>

					<!-- 连接状态：PLC / 扫码枪 / 打码机（同一行三格，样式与口径完全一致）-->
					<Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
						<Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6"
						        Background="{DynamicResource CardBackgroundSolidBrush}">
							<LinearPanel Orientation="Vertical" Spacing="3" HorizontalAlignment="Center">
								<TextBlock Text="PLC" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
								<TextBlock Text="{Binding PlcStatus}" FontSize="15" FontWeight="Bold"
								           Foreground="{Binding PlcStatusColor}" HorizontalAlignment="Center"/>
							</LinearPanel>
						</Border>
						<Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6"
						        Background="{DynamicResource CardBackgroundSolidBrush}">
							<LinearPanel Orientation="Vertical" Spacing="3" HorizontalAlignment="Center">
								<TextBlock Text="扫码枪" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
								<TextBlock Text="{Binding ScannerLinkText}" FontSize="15" FontWeight="Bold"
								           Foreground="{Binding ScannerLinkColor}" HorizontalAlignment="Center"/>
							</LinearPanel>
						</Border>
						<Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6"
						        Background="{DynamicResource CardBackgroundSolidBrush}">
							<LinearPanel Orientation="Vertical" Spacing="3" HorizontalAlignment="Center">
								<TextBlock Text="打码机" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
								<TextBlock Text="{Binding LaserLinkText}" FontSize="15" FontWeight="Bold"
								           Foreground="{Binding LaserLinkColor}" HorizontalAlignment="Center"/>
							</LinearPanel>
						</Border>
					</Grid>

					<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6"
					        Background="{DynamicResource CardBackgroundSolidBrush}">
						<LinearPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
							<TextBlock Text="{Binding HeartbeatAddrText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
							<TextBlock Text="{Binding HeartbeatText}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
						</LinearPanel>
					</Border>

					<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
						<Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6"
						        Background="{DynamicResource CardBackgroundSolidBrush}">
							<LinearPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
								<TextBlock Text="累计 OK" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
								<TextBlock Text="{Binding PlcTotalOk}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
							</LinearPanel>
						</Border>
						<Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6"
						        Background="{DynamicResource CardBackgroundSolidBrush}">
							<LinearPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
								<TextBlock Text="累计 NG" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
								<TextBlock Text="{Binding PlcTotalNg}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
							</LinearPanel>
						</Border>
					</Grid>

					<TextBlock Text="{Binding LiveResultAddrText}" FontSize="11"
					           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
					<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="导通耐压" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
						<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LiveWithstand}" FontSize="13" FontWeight="SemiBold" Margin="0,2"/>
						<TextBlock Grid.Row="1" Grid.Column="0" Text="针高" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
						<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LivePinHeight}" FontSize="13" FontWeight="SemiBold" Margin="0,2"/>
						<TextBlock Grid.Row="2" Grid.Column="0" Text="位置度" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
						<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LivePosition}" FontSize="13" FontWeight="SemiBold" Margin="0,2"/>
					</Grid>
				</LinearPanel>
			</Border>
		</Grid>

		<!-- 产品记录 -->
		<Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="8"
		        Padding="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,10,0,0">
			<Grid RowDefinitions="Auto,*">
				<Grid Grid.Row="0" ColumnDefinitions="*,Auto">
					<LinearPanel Orientation="Horizontal" Spacing="10">
						<TextBlock Text="产品记录（采集落库）" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding CurrentShift}" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding CurrentTime}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
					</LinearPanel>
					<Button Grid.Column="1" Content="交互结构体监控" Command="{Binding OpenMonitorCommand}" VerticalAlignment="Center"/>
				</Grid>
				<DataGrid Grid.Row="1" ItemsSource="{Binding HistoryRecords}"
				          AutoGenerateColumns="False" IsReadOnly="True"
				          GridLinesVisibility="All" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
				          CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False"
				          HeadersVisibility="Column" Margin="0,8,0,0"
				          RowHeight="26" MaxHeight="600"
				          ScrollViewer.HorizontalScrollBarVisibility="Auto"
				          ScrollViewer.VerticalScrollBarVisibility="Auto">
					<DataGrid.Styles>
						<Style Selector="DataGridCell">
							<Setter Property="FontSize" Value="13" />
							<Setter Property="VerticalAlignment" Value="Center" />
						</Style>
						<Style Selector="DataGridColumnHeader">
							<Setter Property="FontSize" Value="13" />
							<Setter Property="FontWeight" Value="SemiBold" />
						</Style>
					</DataGrid.Styles>
					<DataGrid.Columns>
						<DataGridTextColumn Header="采集时间" Binding="{Binding Time}" Width="Auto" />
						<DataGridTextColumn Header="产品码" Binding="{Binding ProductCode}" Width="Auto" />
						<DataGridTextColumn Header="镭码内容" Binding="{Binding MarkContent}" Width="Auto" />
						<DataGridTextColumn Header="码等级" Binding="{Binding CodeLevel}" Width="Auto" />
						<DataGridTextColumn Header="总结果" Binding="{Binding Overall}" Width="Auto" />
						<DataGridTextColumn Header="扫码结果" Binding="{Binding Scan}" Width="Auto" />
						<DataGridTextColumn Header="导通耐压结果" Binding="{Binding Withstand}" Width="Auto" />
						<DataGridTextColumn Header="针高结果" Binding="{Binding PinHeight}" Width="Auto" />
						<DataGridTextColumn Header="位置度结果" Binding="{Binding Position}" Width="Auto" />
						<DataGridTextColumn Header="是否复检" Binding="{Binding IsRetest}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin1(mm)" Binding="{Binding Top1}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin2(mm)" Binding="{Binding Top2}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin3(mm)" Binding="{Binding Top3}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin4(mm)" Binding="{Binding Top4}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin5(mm)" Binding="{Binding Top5}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin6(mm)" Binding="{Binding Top6}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin7(mm)" Binding="{Binding Top7}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin8(mm)" Binding="{Binding Top8}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin9(mm)" Binding="{Binding Top9}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin10(mm)" Binding="{Binding Top10}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin11(mm)" Binding="{Binding Top11}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin12(mm)" Binding="{Binding Top12}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin13(mm)" Binding="{Binding Top13}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin14(mm)" Binding="{Binding Top14}" Width="Auto" />
						<DataGridTextColumn Header="上针高 Pin15(mm)" Binding="{Binding Top15}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin1(mm)" Binding="{Binding Bottom1}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin2(mm)" Binding="{Binding Bottom2}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin3(mm)" Binding="{Binding Bottom3}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin4(mm)" Binding="{Binding Bottom4}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin5(mm)" Binding="{Binding Bottom5}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin6(mm)" Binding="{Binding Bottom6}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin7(mm)" Binding="{Binding Bottom7}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin8(mm)" Binding="{Binding Bottom8}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin9(mm)" Binding="{Binding Bottom9}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin10(mm)" Binding="{Binding Bottom10}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin11(mm)" Binding="{Binding Bottom11}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin12(mm)" Binding="{Binding Bottom12}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin13(mm)" Binding="{Binding Bottom13}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin14(mm)" Binding="{Binding Bottom14}" Width="Auto" />
						<DataGridTextColumn Header="下针高 Pin15(mm)" Binding="{Binding Bottom15}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN1_X" Binding="{Binding TopPosX1}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN2_X" Binding="{Binding TopPosX2}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN3_X" Binding="{Binding TopPosX3}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN4_X" Binding="{Binding TopPosX4}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN5_X" Binding="{Binding TopPosX5}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN6_X" Binding="{Binding TopPosX6}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN7_X" Binding="{Binding TopPosX7}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN8_X" Binding="{Binding TopPosX8}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN9_X" Binding="{Binding TopPosX9}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN10_X" Binding="{Binding TopPosX10}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN11_X" Binding="{Binding TopPosX11}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN12_X" Binding="{Binding TopPosX12}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN13_X" Binding="{Binding TopPosX13}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN14_X" Binding="{Binding TopPosX14}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN15_X" Binding="{Binding TopPosX15}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN1_Y" Binding="{Binding TopPosY1}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN2_Y" Binding="{Binding TopPosY2}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN3_Y" Binding="{Binding TopPosY3}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN4_Y" Binding="{Binding TopPosY4}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN5_Y" Binding="{Binding TopPosY5}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN6_Y" Binding="{Binding TopPosY6}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN7_Y" Binding="{Binding TopPosY7}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN8_Y" Binding="{Binding TopPosY8}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN9_Y" Binding="{Binding TopPosY9}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN10_Y" Binding="{Binding TopPosY10}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN11_Y" Binding="{Binding TopPosY11}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN12_Y" Binding="{Binding TopPosY12}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN13_Y" Binding="{Binding TopPosY13}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN14_Y" Binding="{Binding TopPosY14}" Width="Auto" />
						<DataGridTextColumn Header="上位置度 PIN15_Y" Binding="{Binding TopPosY15}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN1_X" Binding="{Binding BottomPosX1}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN2_X" Binding="{Binding BottomPosX2}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN3_X" Binding="{Binding BottomPosX3}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN4_X" Binding="{Binding BottomPosX4}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN5_X" Binding="{Binding BottomPosX5}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN6_X" Binding="{Binding BottomPosX6}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN7_X" Binding="{Binding BottomPosX7}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN8_X" Binding="{Binding BottomPosX8}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN9_X" Binding="{Binding BottomPosX9}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN10_X" Binding="{Binding BottomPosX10}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN11_X" Binding="{Binding BottomPosX11}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN12_X" Binding="{Binding BottomPosX12}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN13_X" Binding="{Binding BottomPosX13}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN14_X" Binding="{Binding BottomPosX14}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN15_X" Binding="{Binding BottomPosX15}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN1_Y" Binding="{Binding BottomPosY1}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN2_Y" Binding="{Binding BottomPosY2}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN3_Y" Binding="{Binding BottomPosY3}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN4_Y" Binding="{Binding BottomPosY4}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN5_Y" Binding="{Binding BottomPosY5}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN6_Y" Binding="{Binding BottomPosY6}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN7_Y" Binding="{Binding BottomPosY7}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN8_Y" Binding="{Binding BottomPosY8}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN9_Y" Binding="{Binding BottomPosY9}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN10_Y" Binding="{Binding BottomPosY10}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN11_Y" Binding="{Binding BottomPosY11}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN12_Y" Binding="{Binding BottomPosY12}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN13_Y" Binding="{Binding BottomPosY13}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN14_Y" Binding="{Binding BottomPosY14}" Width="Auto" />
						<DataGridTextColumn Header="下位置度 PIN15_Y" Binding="{Binding BottomPosY15}" Width="Auto" />
					</DataGrid.Columns>
				</DataGrid>
			</Grid>
		</Border>

		<!-- 实时消息 -->
		<Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="8"
		        Padding="12,8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,10,0,0" MinHeight="72">
			<LinearPanel Orientation="Vertical" Spacing="6">
				<TextBlock Text="实时消息" FontSize="14" FontWeight="Bold"/>
				<TextBlock Text="{Binding PlcDataReadResult}" FontSize="12" TextWrapping="Wrap"
				           Foreground="{DynamicResource ThemeAccentBrush}"/>
			</LinearPanel>
		</Border>
	</Grid>
</UserControl>
