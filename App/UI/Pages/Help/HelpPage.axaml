<UiView xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="clr-namespace:AppZC.UI.Pages"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AppZC.UI.Pages.HelpPage"
        x:DataType="pages:HelpVM">
    <Design.DataContext>
        <pages:HelpVM />
    </Design.DataContext>
    
    <Grid ColumnDefinitions="280,*">
        <!-- 左侧章节列表 -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource CardBackgroundDarkBrush}">
            <LinearPanel Orientation="Vertical">
                <!-- 标题 -->
                <Border  Padding="20,15">
                    <LinearPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="📚" FontSize="24" VerticalAlignment="Center" />
                        <TextBlock Text="操作手册" FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" />
                    </LinearPanel>
                </Border>
                
                <!-- 章节列表 -->
                <ListBox ItemsSource="{Binding Sections}"
                        SelectedItem="{Binding SelectedSection}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="5">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="5,2" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="15,12" CornerRadius="8" Background="Transparent">
                                <LinearPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="15" VerticalAlignment="Center" />
                                </LinearPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </LinearPanel>
        </Border>
        
        <!-- 右侧内容区域 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0">
            <LinearPanel Orientation="Vertical" Padding="40,30" Spacing="25">
                <!-- 章节标题 -->
                <LinearPanel Orientation="Horizontal" Spacing="15">
                    <TextBlock Text="{Binding SelectedSection.Icon}" FontSize="36" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedSection.Title}" 
                              FontSize="32" 
                              FontWeight="Bold" 
                              Foreground="{DynamicResource PrimaryBrush}"
                              VerticalAlignment="Center" />
                </LinearPanel>
                
                <Separator Background="{DynamicResource BorderBrush}" Height="2" />
                
                <!-- 内容项列表 -->
                <ItemsControl ItemsSource="{Binding SelectedSection.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,0,0,25">
                                <LinearPanel Orientation="Vertical" Spacing="12">
                                    <!-- 小标题 -->
                                    <LinearPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="4" Background="{DynamicResource PrimaryBrush}" CornerRadius="2" />
                                        <TextBlock Text="{Binding Title}" 
                                                  FontSize="18" 
                                                  FontWeight="SemiBold"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  VerticalAlignment="Center" />
                                    </LinearPanel>
                                    
                                    <!-- 内容 -->
                                    <Border Background="{DynamicResource CardBackgroundBrush}" 
                                           Padding="20,15" 
                                           CornerRadius="8"
                                           BorderBrush="{DynamicResource BorderBrush}"
                                           BorderThickness="1">
                                        <TextBlock Text="{Binding Content}" 
                                                  FontSize="14" 
                                                  TextWrapping="Wrap"
                                                  LineHeight="22"
                                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </LinearPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </LinearPanel>
        </ScrollViewer>
    </Grid>
</UiView>
