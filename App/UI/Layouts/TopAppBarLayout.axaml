<ApplicationLayoutView
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ui="clr-namespace:AppZC.UI"
	mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
	x:Class="AppZC.UI.Layouts.TopAppBarLayout"
	x:DataType="ui:AppVM" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="Auto,*">
	<Design.DataContext>
		<ui:AppVM />
	</Design.DataContext>

	<!-- 顶部导航栏 -->
	<LinearPanel Name="AppBarPanel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
				 Orientation="Horizontal" MinHeight="44"
				 Background="{DynamicResource GlassTopBarBrush}">
		<Border Width="{Binding AppBarSettings.LeftUsedWidth, Mode=OneWay}" />
		<Grid LinearPanel.Weight="1" Margin="8,0,0,0">
			<TabStrip Name="TabStrip1"
						Theme="{StaticResource TabStrip-Button}"
						Height="{Binding Path=AppBarSettings.Height, Mode=OneWayToSource}"
						ItemsSource="{Binding NavManager.NavInfos}"
						SelectedItem="{Binding SelectedNavData}">
				<TabStrip.Styles>
					<Style Selector="TabStripItem">
						<Setter Property="Padding" Value="18,8" />
						<Setter Property="Margin" Value="2,4" />
						<Setter Property="MinHeight" Value="0" />
						<Setter Property="FontSize" Value="14" />
						<Setter Property="FontWeight" Value="Medium" />
						<Setter Property="CornerRadius" Value="2" />
						<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
						<Setter Property="Background" Value="Transparent" />
					</Style>
					<Style Selector="TabStripItem:selected">
						<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
						<Setter Property="Background" Value="Transparent" />
					</Style>
				</TabStrip.Styles>
				<TabStrip.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Header}" />
					</DataTemplate>
				</TabStrip.ItemTemplate>
			</TabStrip>
			<!-- 滑动高亮指示器 -->
			<Border Name="TabIndicator"
					Height="3" Width="0" CornerRadius="1.5"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					Background="{DynamicResource PrimaryBrush}"
					RenderTransformOrigin="0,0.5">
				<Border.RenderTransform>
					<TranslateTransform X="0" />
				</Border.RenderTransform>
			</Border>
		</Grid>
		<Border Width="{Binding AppBarSettings.RightUseWidth, Mode=OneWay}" />
	</LinearPanel>

	<!-- 顶部分割线 -->
	<Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
			BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}" />

	<!-- 左侧导航栏 -->
	<Border Grid.Row="2" Grid.Column="0"
			BorderThickness="0,0,1,0"
			BorderBrush="{DynamicResource DividerBrush}"
			Background="{DynamicResource GlassSidebarBrush}"
			IsVisible="{Binding LeftNavHasItems}">
		<ListBox Name="LeftNavListBox"
				 Width="140"
				 ItemsSource="{Binding LeftNavItems}"
				 SelectedItem="{Binding SelectedLeftNavData}"
				 Background="Transparent"
				 BorderThickness="0"
				 Padding="8,8">
			<ListBox.Styles>
				<Style Selector="ListBoxItem">
					<Setter Property="Padding" Value="14,12" />
					<Setter Property="Margin" Value="0,2" />
					<Setter Property="HorizontalContentAlignment" Value="Left" />
					<Setter Property="CornerRadius" Value="2" />
					<Setter Property="FontSize" Value="13" />
					<Setter Property="FontWeight" Value="Medium" />
					<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
				</Style>
				<Style Selector="ListBoxItem:pointerover">
					<Setter Property="Background" Value="#1AFFFFFF" />
				</Style>
				<Style Selector="ListBoxItem:selected">
					<Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
					<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
					<Setter Property="FontWeight" Value="SemiBold" />
				</Style>
			</ListBox.Styles>
			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Header}"
							   TextWrapping="Wrap" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Border>

	<!-- 主内容区域 Grid.Row="2" Grid.Column="1" 会在代码中动态添加 -->

	<!-- 全局状态栏 -->
	<Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,1,0,0"
			Padding="20,8"
			Background="{DynamicResource GlassTopBarBrush}"
			Margin="0">
		<Grid ColumnDefinitions="*,Auto">
			<!-- 左侧：系统状态（模板中性） -->
			<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
				<Border Width="8" Height="8" CornerRadius="2" Background="#4CAF50" VerticalAlignment="Center" />
				<TextBlock Text="系统就绪" FontSize="12" VerticalAlignment="Center"
						   Foreground="{DynamicResource TextSecondaryBrush}" />
			</StackPanel>
			<!-- 右侧：时间和版本号 -->
			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20">
				<TextBlock Text="{Binding GlobalCurrentTime}" FontSize="12" VerticalAlignment="Center"
						   Foreground="{DynamicResource TextTertiaryBrush}" />
				<TextBlock Text="{Binding GlobalSoftwareVersion}" FontSize="12" VerticalAlignment="Center"
						   Foreground="{DynamicResource PrimaryBrush}" />
			</StackPanel>
		</Grid>
	</Border>
</ApplicationLayoutView>
