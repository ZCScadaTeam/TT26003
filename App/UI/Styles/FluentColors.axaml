<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 主题感知配色：Dark / Light 双字典 ============ -->
    <ResourceDictionary.ThemeDictionaries>
        <!-- 深色（赛博朋克紫） -->
        <ResourceDictionary x:Key="Dark">
            <!-- 主色系 -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#B07AFF" />
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#C9A0FF" />
            <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#9333EA" />
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#3D2280" />
            <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#B07AFF" Offset="0" />
                <GradientStop Color="#7C6CFF" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="SuccessBrush" Color="#35E0EE" />
            <SolidColorBrush x:Key="SuccessLightBrush" Color="#1A6E80" />
            <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#35E0EE" Offset="0" />
                <GradientStop Color="#06B6D4" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="WarningBrush" Color="#FFA44D" />
            <SolidColorBrush x:Key="WarningLightBrush" Color="#A04420" />
            <LinearGradientBrush x:Key="WarningGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#FFA44D" Offset="0" />
                <GradientStop Color="#F97316" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="DangerBrush" Color="#F5567A" />
            <SolidColorBrush x:Key="DangerLightBrush" Color="#A01840" />
            <LinearGradientBrush x:Key="DangerGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#F5567A" Offset="0" />
                <GradientStop Color="#E11D48" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="InfoBrush" Color="#F580C0" />
            <SolidColorBrush x:Key="InfoLightBrush" Color="#A02060" />

            <!-- 面板明暗分层 -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#1A1530" />
            <SolidColorBrush x:Key="GlassPanelBrush" Color="#1A1530" />
            <SolidColorBrush x:Key="GlassSidebarBrush" Color="#201B3A" />
            <SolidColorBrush x:Key="GlassTopBarBrush" Color="#262042" />
            <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#262042" />

            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2E2750" />
            <SolidColorBrush x:Key="CardBackgroundDarkBrush" Color="#262042" />
            <SolidColorBrush x:Key="CardBackgroundSolidBrush" Color="#1E1938" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#4A4090" />
            <SolidColorBrush x:Key="CardBorderLightBrush" Color="#5E55A8" />
            <SolidColorBrush x:Key="CardShadowBrush" Color="#60B07AFF" />

            <SolidColorBrush x:Key="BorderBrush" Color="#4A4090" />
            <SolidColorBrush x:Key="BorderLightBrush" Color="#5E55A8" />
            <SolidColorBrush x:Key="DividerBrush" Color="#3A3070" />

            <!-- 输入框 -->
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#201B3A" />
            <SolidColorBrush x:Key="InputBackgroundDisabledBrush" Color="#1A1530" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#4A4090" />
            <SolidColorBrush x:Key="InputBorderFocusBrush" Color="#B07AFF" />

            <!-- 文字 -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F0FC" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D4C8F0" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#A098C0" />
            <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextLinkBrush" Color="#C9A0FF" />

            <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#3A3070" />

            <SolidColorBrush x:Key="WindowCloseBrush" Color="#F5567A" />
            <SolidColorBrush x:Key="WindowMinimizeBrush" Color="#FFD060" />
            <SolidColorBrush x:Key="WindowMaximizeBrush" Color="#35E0EE" />

            <!-- 悬停叠加层（hover / pointerover） -->
            <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1AFFFFFF" />
        </ResourceDictionary>

        <!-- 浅色（同色系浅底） -->
        <ResourceDictionary x:Key="Light">
            <!-- 主色系 -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#7C3AED" />
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#8B5CF6" />
            <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#6D28D9" />
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EDE9FE" />
            <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#8B5CF6" Offset="0" />
                <GradientStop Color="#6366F1" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="SuccessBrush" Color="#0891B2" />
            <SolidColorBrush x:Key="SuccessLightBrush" Color="#CFFAFE" />
            <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#22D3EE" Offset="0" />
                <GradientStop Color="#0891B2" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="WarningBrush" Color="#EA580C" />
            <SolidColorBrush x:Key="WarningLightBrush" Color="#FFEDD5" />
            <LinearGradientBrush x:Key="WarningGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#FB923C" Offset="0" />
                <GradientStop Color="#EA580C" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="DangerBrush" Color="#E11D48" />
            <SolidColorBrush x:Key="DangerLightBrush" Color="#FFE4E6" />
            <LinearGradientBrush x:Key="DangerGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#FB7185" Offset="0" />
                <GradientStop Color="#E11D48" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="InfoBrush" Color="#C026D3" />
            <SolidColorBrush x:Key="InfoLightBrush" Color="#FCE7F3" />

            <!-- 面板明暗分层 -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F3F8" />
            <SolidColorBrush x:Key="GlassPanelBrush" Color="#F4F3F8" />
            <SolidColorBrush x:Key="GlassSidebarBrush" Color="#FBFAFE" />
            <SolidColorBrush x:Key="GlassTopBarBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundDarkBrush" Color="#F3F1F9" />
            <SolidColorBrush x:Key="CardBackgroundSolidBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E0EC" />
            <SolidColorBrush x:Key="CardBorderLightBrush" Color="#D8D4E6" />
            <SolidColorBrush x:Key="CardShadowBrush" Color="#22000000" />

            <SolidColorBrush x:Key="BorderBrush" Color="#E3E0EC" />
            <SolidColorBrush x:Key="BorderLightBrush" Color="#D8D4E6" />
            <SolidColorBrush x:Key="DividerBrush" Color="#ECEAF2" />

            <!-- 输入框 -->
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InputBackgroundDisabledBrush" Color="#F1F0F5" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#D8D4E6" />
            <SolidColorBrush x:Key="InputBorderFocusBrush" Color="#7C3AED" />

            <!-- 文字 -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2430" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#525A6B" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A90A2" />
            <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextLinkBrush" Color="#7C3AED" />

            <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#E3E0EC" />

            <SolidColorBrush x:Key="WindowCloseBrush" Color="#E11D48" />
            <SolidColorBrush x:Key="WindowMinimizeBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="WindowMaximizeBrush" Color="#0891B2" />

            <!-- 悬停叠加层（hover / pointerover） -->
            <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
